# Copy this file to ".env" and fill in your real values. NEVER commit ".env".

# From Upstash console > your database > Details. Note "rediss://" with two s (TLS).
# Format: rediss://default:<YOUR_TOKEN>@enjoyed-crow-158420.upstash.io:6379
REDIS_URL=rediss://default:gQAAAAAAAmrUAAIgcDJjMmEzMWJjZDc5NTI0MTg4YTk0NDhmYmRkMzc1ZmFhMw@enjoyed-crow-158420.upstash.io:6379

MAX_RETRIES=3
BACKOFF_BASE_SECONDS=2

# "mock" = log only, "smtp" = really send
EMAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your.address@gmail.com
